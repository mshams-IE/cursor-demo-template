{
  "name": "cursor-demo-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "kit"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:offline": "tsc -b && vite build --mode offline",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "gates": "demo-gates",
    "gates:spec": "demo-gates --spec",
    "gates:samples": "demo-gates --all-samples",
    "shots": "playwright test",
    "use-sample": "node scripts/use-sample.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run gates"
  },
  "dependencies": {
    "@cloudera-demos/kit": "0.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
