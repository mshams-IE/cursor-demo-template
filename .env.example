# Digital Expert model connection (optional). Without a key the experts answer from the local engine.
# Copy to .env.local for local development; the values are read by the dev and preview servers only
# and are never sent to the browser.
#
# On Cursor Cloud, add these under Cursor Dashboard > Cloud Agents > Secrets instead of a file.

# OpenAI API key. Leave empty to keep the local engine.
OPENAI_API_KEY=

# Chat-completions model with tool calling. Defaults to gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-mini

# OpenAI-compatible base URL ending in /v1. Defaults to https://api.openai.com/v1.
# For tests against the mock server (node scripts/mock-llm.mjs): http://127.0.0.1:5190/v1 with OPENAI_API_KEY=mock
OPENAI_BASE_URL=
